PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
DB_PATH=./server/db/vibesurvey.db
# Lop CSDL: sqlite (mac dinh, file cuc bo) | turso (bat buoc remote, fail-closed) | auto
# auto: dung Turso khi da cau hinh, con lai dung SQLite; da cau hinh thi khong tu fallback.
DB_DRIVER=sqlite
# Turso/libSQL remote: chi dung khi DB_DRIVER=turso hoac auto. Khong commit token that.
# Gia tri mau ben duoi se bi tu choi; phai thay bang URL/token Turso that.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
TURSO_TIMEOUT_MS=15000
BASE_EXCHANGE_RATE=10
MIN_PAYOUT_POINTS=5000
PLATFORM_TAKE_RATE=0.40
PAYOUT_FEE_VND=2000

# Cấu hình dịch vụ Email Brevo (Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@gmail.com
BREVO_SENDER_NAME=VibeSurvey Platform

# Audit bao mat 03-11-2026
# Mat khau seed tai khoan quan tri (email=matkhau, phan cach boi dau phay) - bat buoc cau hinh, khong ghi trong ma nguon
SEED_ACCOUNT_PASSWORDS=admin@yourdomain.com=your_strong_password_here
# Secret xac thuc webhook doi soat ngan hang (bat buoc, toi thieu 32 ky tu ngau nhien)
PAYMENT_WEBHOOK_SECRET=your_random_webhook_secret_here

# Cong thanh toan VietQR Napas247 (bat buoc khi dung chuc nang nap tien)
PAYMENT_BANK_ID=MB
PAYMENT_BANK_NAME=Your Bank Name
PAYMENT_ACCOUNT_NUMBER=your_account_number
PAYMENT_ACCOUNT_NAME=RECEIVER NAME
PAYMENT_QR_TEMPLATE=compact
# CORS cho phep rieng (list phan cach boi dau phay, bo trong = chi localhost + APP_URL + Capacitor)
CORS_ORIGINS=
